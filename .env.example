# ==========================================
# 1. Google Gemini API
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# 2. Gmail IMAP (чтение писем) и SMTP (отправка дайджеста)
# Создайте 16-значный "Пароль приложения" (App Password) в настройках Google Аккаунта:
# Google Account -> Security -> 2-Step Verification -> App passwords
# ==========================================
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Куда отправлять готовый email-дайджест (по умолчанию совпадает с GMAIL_USER)
RECIPIENT_EMAIL=your_email@gmail.com

# ==========================================
# 3. Telegram Bot (для доставки сводки и ссылки на Telegraph Instant View)
# Создайте бота через @BotFather и узнайте свой ID через @userinfobot
# (Безопасно: это токен бота, а НЕ ваш личный аккаунт Telegram!)
# ==========================================
TG_BOT_TOKEN=1234567890:AAH_your_bot_token_here
TG_CHAT_ID=123456789

# ==========================================
# 4. Опционально: Telegraph токен (если пусто — создается автоматически)
# ==========================================
TELEGRAPH_ACCESS_TOKEN=
